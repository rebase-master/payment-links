# Copy to .env and fill in. The app validates these at startup and refuses
# to boot if any are missing or malformed (see src/config/env.validation.ts).

NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://payment_links:payment_links@localhost:5442/payment_links

# Mixed into every API key before hashing for merchant lookup. Optional in dev
# (blank = no pepper); set a strong random value in production. The seeded demo
# merchant's key is `pl_test_acme_dev_key` (see prisma/seed.ts).
API_KEY_PEPPER=
