generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  MERCHANT_BALANCE
  PLATFORM_CLEARING
}

enum PaymentLinkStatus {
  ACTIVE
  PAID
  EXPIRED
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model Merchant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(120)
  apiKeyHash String   @unique @map("api_key_hash") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts     Account[]
  paymentLinks PaymentLink[]

  @@map("merchants")
}

model Account {
  id         String      @id @default(uuid()) @db.Uuid
  merchantId String?     @map("merchant_id") @db.Uuid
  type       AccountType
  currency   String      @db.Char(3)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  merchant      Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  // One account per (merchant, type, currency). Standard SQL treats every
  // NULL as distinct, so this alone would not stop two NULL-merchant
  // PLATFORM_CLEARING accounts in the same currency — the partial unique
  // below closes that gap for that one case specifically.
  @@unique([merchantId, type, currency])
  @@unique([type, currency], where: { merchantId: null }, map: "accounts_platform_clearing_unique")
  @@map("accounts")
}

model PaymentLink {
  id          String            @id @default(uuid()) @db.Uuid
  merchantId  String            @map("merchant_id") @db.Uuid
  amount      BigInt // minor units (fils, cents)
  currency    String            @db.Char(3)
  status      PaymentLinkStatus @default(ACTIVE)
  description String?           @db.VarChar(255)
  reference   String?           @db.VarChar(80)
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  payments Payment[]

  @@index([merchantId, status])
  @@index([status, expiresAt])
  @@map("payment_links")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  paymentLinkId     String        @map("payment_link_id") @db.Uuid
  amount            BigInt
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  provider          String        @db.VarChar(40)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(120)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentLink   PaymentLink   @relation(fields: [paymentLinkId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([provider, providerPaymentId])
  @@index([paymentLinkId])
  @@map("payments")
}

model LedgerEntry {
  id        BigInt          @id @default(autoincrement())
  accountId String          @map("account_id") @db.Uuid
  // Also the grouping key for "debits = credits" balance checks on one
  // posting. A generic journal/transaction_id (for postings that aren't
  // tied to a payment, e.g. manual corrections) is deferred until that
  // feature is actually designed — see PR #3 review, item #6.
  paymentId String?         @map("payment_id") @db.Uuid
  direction LedgerDirection
  amount    BigInt // always positive; direction carries the sign
  currency  String          @db.Char(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account  @relation(fields: [accountId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([paymentId])
  @@map("ledger_entries")
}

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  scope        String            @db.VarChar(60)
  key          String            @db.VarChar(200)
  requestHash  String            @map("request_hash") @db.VarChar(64)
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseBody Json?             @map("response_body")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // (scope, key) is not merchant-scoped, so two merchants could collide on
  // the same key. Deferred, along with response_status/expires_at/
  // locked_at, until the PR that implements the idempotency-check flow —
  // this table has no consumer yet, and those columns are easier to get
  // right once real code is reading and writing them. See PR #3 review,
  // item #8.
  @@unique([scope, key])
  @@map("idempotency_keys")
}

model ProviderEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String    @db.VarChar(40)
  providerEventId String    @map("provider_event_id") @db.VarChar(120)
  type            String    @db.VarChar(80)
  payload         Json
  signature       String?   @db.VarChar(256)
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@map("provider_events")
}

model OutboxMessage {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(60)
  aggregateId   String    @map("aggregate_id") @db.VarChar(64)
  eventType     String    @map("event_type") @db.VarChar(80)
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)

  // Matches the relay's actual query (WHERE published_at IS NULL ORDER BY
  // created_at) and stays small as published rows accumulate, unlike a
  // plain index on the whole column.
  @@index([createdAt], where: { publishedAt: null }, map: "outbox_messages_pending_idx")
  @@map("outbox_messages")
}
